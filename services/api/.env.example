# healthyIndia API - Local Development Environment Variables
# Copy to .env for local overrides (never commit real .env files)

# Environment: local | test | staging | production
ENVIRONMENT=local
DEBUG=true

# Server binding
HOST=127.0.0.1
PORT=8000

# Secret key: MUST be replaced with a high-entropy secret in staging/production
SECRET_KEY=insecure-dev-secret-key-replace-in-production-min-32-chars

# Restrictive CORS: JSON array or comma-separated list of allowed origins
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Allowed hosts for Host header filtering
ALLOWED_HOSTS=["localhost","127.0.0.1","testserver"]

# Request size limit (1 MB in bytes)
MAX_REQUEST_BODY_BYTES=1048576

# Request timeout in seconds
REQUEST_TIMEOUT_SECONDS=30.0
